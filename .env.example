TALK_BOT_SECRET=replace-with-nextcloud-talk-bot-secret
NEXTCLOUD_URL=https://nextcloud.example.com
TALK_BRIDGE_PORT=8788
TALK_BRIDGE_BIND=0.0.0.0

# Hermes invocation
HERMES_BIN=hermes
HERMES_PROFILE=default
HERMES_HOME_DIR=/home/your-user
HERMES_SOURCE=nextcloud-talk-hermes-bridge
HERMES_TOOLSETS=terminal,file,code_execution,skills,memory,session_search,cronjob,web,vision,delegation
HERMES_SKILLS=messaging-bridge-ops,hermes-agent
HERMES_MAX_TURNS=90
HERMES_ACCEPT_HOOKS=1
HERMES_YOLO=1

# Assistant persona
ASSISTANT_NAME=Hermes Talk Assistant
ASSISTANT_ROLE=You are a helpful private assistant inside Nextcloud Talk. Be accurate, concise, privacy-aware, and practical.

# Runtime/logging
TALK_BRIDGE_APP_NAME=nextcloud-talk-hermes-bridge
TALK_BRIDGE_LOG=/home/your-user/.local/state/nextcloud-talk-hermes-bridge/bridge.log
TALK_CONTEXT_DIR=/home/your-user/.local/share/nextcloud-talk-context/nextcloud-talk-hermes-bridge
TALK_BRIDGE_SOFT_TIMEOUT=180
TALK_BRIDGE_HARD_TIMEOUT=900
TALK_BRIDGE_BACKGROUND_HEARTBEAT=120

# Optional local SQLite memory context
TALK_LOCAL_MEMORY_CONTEXT=1
TALK_MEMORY_NAMESPACE=assistant
# TALK_MEMORY_DB_PATH=/home/your-user/.hermes/local-memory/memory.sqlite3

# Optional Nextcloud AI/document context lookup for Hermes prompts
# Disabled by default. When enabled, Phase 1 performs bounded deterministic
# Nextcloud file search and injects candidate file matches into Hermes context.
NEXTCLOUD_AI_CONTEXT=0
NEXTCLOUD_AI_CONTEXT_MODE=files_search
NEXTCLOUD_AI_CONTEXT_MAX_CHARS=4000
NEXTCLOUD_AI_CONTEXT_TIMEOUT=20
NEXTCLOUD_AI_CONTEXT_MIN_QUERY_CHARS=12
NEXTCLOUD_AI_CONTEXT_INCLUDE_PATHS=1
NEXTCLOUD_AI_CONTEXT_LIMIT=6
# NEXTCLOUD_AI_USER=nextcloud-user-id
# NEXTCLOUD_AI_APP_PASSWORD=nextcloud-app-password

# Optional voice/audio transcription for Talk file-share payloads
NEXTCLOUD_DATA_ROOT=/var/www/html/data
TALK_NEXTCLOUD_CONTAINER=nextcloud
# TALK_NEXTCLOUD_USER=nextcloud-user-id
TALK_FFMPEG_BIN=ffmpeg
TALK_WHISPER_BIN=whisper-cli
# TALK_WHISPER_MODEL=/path/to/ggml-model.bin
TALK_TRANSCRIBE_MAX_BYTES=52428800
TALK_TRANSCRIBE_TIMEOUT=180
